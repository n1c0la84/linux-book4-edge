/dts-v1/;

#include <dt-bindings/leds/common.h>

#include "x1e-samsung-galaxy-book4-edge.dtsi"

/ {
	model = "Samsung Galaxy Book4 Edge (14 inch)";
	compatible = "samsung,galaxy-book4-edge-14", "samsung,galaxy-book4-edge",
		     "qcom,x1e80100";

	camera-leds {
		compatible = "gpio-leds";

		pinctrl-0 = <&cam_indicator_en>;
		pinctrl-names = "default";

		cam_privacy_led: led-camera-indicator {
			label = "white:camera-indicator";
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 110 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&camss {
	vdd-csiphy-0p8-supply = <&vreg_l2c_0p8>;
	vdd-csiphy-1p2-supply = <&vreg_l1c_1p2>;

	status = "okay";

	ports {
		port@0 {
			csiphy0_ep: endpoint {
				data-lanes = <0 1>;
				remote-endpoint = <&ov02c10_ep>;
			};
		};
	};
};

&cci0 {
	status = "okay";
};

&cci0_i2c0 {
	clock-frequency = <100000>;

	camera@36 {
		compatible = "ovti,ov02c10";
		reg = <0x36>;

		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam_rgb_default>;
		pinctrl-names = "default";

		clocks = <&camcc CAM_CC_MCLK4_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
		assigned-clock-rates = <19200000>;

		avdd-supply = <&vreg_l7b_2p8>;
		dvdd-supply = <&vreg_l7b_2p8>;
		dovdd-supply = <&vreg_l10b_1p8>;

		leds = <&cam_privacy_led>;
		led-names = "privacy";

		orientation = <0>; /* front */
		rotation = <180>;

		port {
			ov02c10_ep: endpoint {
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <400000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};
};

&{/sound} {
	audio-routing = "SpkrRight IN", "WSA WSA_SPK1 OUT",
			"TweeterRight IN", "WSA WSA_SPK2 OUT",
			"SpkrLeft IN", "WSA2 WSA_SPK1 OUT",
			"TweeterLeft IN", "WSA2 WSA_SPK2 OUT",
			"IN1_HPHL", "HPHL_OUT",
			"IN2_HPHR", "HPHR_OUT",
			"AMIC2", "MIC BIAS2",
			"VA DMIC0", "MIC BIAS3",
			"VA DMIC1", "MIC BIAS3",
			"VA DMIC2", "MIC BIAS1",
			"VA DMIC3", "MIC BIAS1",
			"TX SWR_INPUT1", "ADC2_OUTPUT";
};

&{/sound/wsa-dai-link/codec} {
	sound-dai = <&left_spkr 0>, <&right_tweeter 0>, <&swr0 0>, <&lpass_wsamacro 0>,
		    <&right_spkr 0>, <&left_tweeter 0>, <&swr3 0>, <&lpass_wsa2macro 0>;
};

/*
 * VI (voltage and current) feedback from the four amplifiers, for speaker
 * protection. Each bus brings back two amps' VISENSE ports on its two VI
 * input ports (10, 11) through the macro's VI interface; both macros feed one
 * DSP codec DMA port, as in Windows' graph (where the DSP side uses both WSA
 * interfaces). Layout from Qualcomm's glymur-crd link (kernel-topics PR #2104).
 */
&{/sound} {
	vi-feedback-dai-link {
		link-name = "CODEC_DMA-LPAIF_WSA-TX-0";

		cpu {
			sound-dai = <&q6apmbedai WSA_CODEC_DMA_TX_0>;
		};

		codec {
			sound-dai = <&left_spkr 1>, <&right_tweeter 1>,
				    <&swr0 9>, <&swr0 10>,
				    <&lpass_wsamacro 2>,
				    <&right_spkr 1>, <&left_tweeter 1>,
				    <&swr3 9>, <&swr3 10>,
				    <&lpass_wsa2macro 2>;
		};

		platform {
			sound-dai = <&q6apm>;
		};
	};
};

&i2c13 {
	touchpad@40 {
		compatible = "hid-over-i2c";
		reg = <0x40>;

		hid-descr-addr = <0xe>;
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&tpad_default>;
		pinctrl-names = "default";
	};
};

&panel {
	compatible = "samsung,atna40cu07", "samsung,atna33xc20";
};

&tlmm {
	/* Raised before the sensor is reset (Windows CAMF_RES_QRD.bin: 99, then 96) */
	cam-vdd-en-96-hog {
		gpio-hog;
		gpios = <96 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "cam-vdd-en-96";
	};

	cam-vdd-en-99-hog {
		gpio-hog;
		gpios = <99 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "cam-vdd-en-99";
	};

	cam-shutter-hog {
		gpio-hog;
		gpios = <221 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "cam-shutter-enable";
	};

	cam-enable-hog {
		gpio-hog;
		gpios = <225 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "cam-enable";
	};

	cam_indicator_en: cam-indicator-en-state {
		pins = "gpio110";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	cam_rgb_default: cam-rgb-default-state {
		mclk-pins {
			pins = "gpio100";
			function = "cam_aon";
			drive-strength = <16>;
			bias-disable;
		};

		reset-n-pins {
			pins = "gpio109";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

&swr0 {
	/* WSA8835 tweeter, right side; macro output SPK2 (RX1) */
	right_tweeter: speaker@0,1 {
		compatible = "sdw10217020200";
		reg = <0 1>;
		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <1>;
		#thermal-sensor-cells = <0>;
		sound-name-prefix = "TweeterRight";
		vdd-supply = <&vreg_l15b_1p8>;
		qcom,port-mapping = <4 5 6 11>;
	};
};

&swr3 {
	/* WSA8835 tweeter, left side; macro output SPK2 (RX1) */
	left_tweeter: speaker@0,1 {
		compatible = "sdw10217020200";
		reg = <0 1>;
		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <1>;
		#thermal-sensor-cells = <0>;
		sound-name-prefix = "TweeterLeft";
		vdd-supply = <&vreg_l15b_1p8>;
		qcom,port-mapping = <4 5 6 11>;
	};
};

/* Fingerprint reader (EgisTec 1c7a:05a1) on usb_2. */
&usb_2 {
	dr_mode = "host";

	status = "okay";
};

&usb_2_hsphy {
	vdd-supply = <&vreg_l2e_0p8>;
	vdda12-supply = <&vreg_l3e_1p2>;

	phys = <&eusb6_repeater>;

	status = "okay";
};

/*
 * The woofer names in the shared dtsi are swapped on this model: the
 * amplifier on SoundWire 0 (WSA macro) drives the right woofer, the one on
 * SoundWire 3 (WSA2 macro) the left woofer, next to the tweeters of the same
 * side. Name them by side, like the tweeters. The labels stay as in the dtsi.
 */
&left_spkr {
	sound-name-prefix = "SpkrRight";
};

&right_spkr {
	sound-name-prefix = "SpkrLeft";
};

/*
 * Only the eUSB2 repeater at 0x4f (usb_2, the fingerprint reader) exists on
 * this model; the firmware describes nothing at 0x43.
 */
&eusb5_repeater {
	status = "disabled";
};
